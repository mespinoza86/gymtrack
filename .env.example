NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://gymtrack_app:CAMBIAR_ESTA_CLAVE@localhost:5432/gymtrack
DATABASE_SSL=false
SESSION_SECRET=CAMBIAR_POR_UNA_FRASE_LARGA_ALEATORIA_DE_32_CARACTERES_O_MAS
APP_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=5

# --- Correo (recuperación de contraseña y confirmación de cuenta) ---
# console = escribe el correo en la terminal y no envía nada. Es lo correcto
#           para desarrollo y para las pruebas automatizadas.
# brevo   = envía de verdad con una dirección de remitente verificada.
#           No necesita dominio propio. Es la configuración actual.
# resend  = envía de verdad con un dominio propio verificado. Mejor
#           entregabilidad; ya está programado y listo para el día que exista
#           dominio. Solo hay que cambiar este valor, MAIL_API_KEY y MAIL_FROM.
MAIL_TRANSPORT=console

# Solo hacen falta con MAIL_TRANSPORT=brevo.
# MAIL_FROM debe ser una dirección verificada en Brevo (Senders & IP).
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=GymTrack

# Vigencia de los enlaces, en horas.
RESET_TOKEN_HOURS=1
VERIFY_TOKEN_HOURS=24
